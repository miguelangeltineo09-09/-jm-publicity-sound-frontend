# Ver https://help.github.com/articles/ignoring-files/ para más información.

# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Cobertura de tests
/coverage

# Salida de compilación de Next.js
/.next/
/out/

# Build de producción
/build

# Archivos varios del sistema operativo / certificados locales
.DS_Store
*.pem

# Logs de depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables de entorno (contienen datos sensibles, nunca se versionan)
.env*

# Vercel (configuración local de despliegue)
.vercel

# Archivos generados por TypeScript/Next.js
*.tsbuildinfo
next-env.d.ts
